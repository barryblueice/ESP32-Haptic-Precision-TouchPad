    # This file was generated using idf.py save-defconfig. It can be edited manually.
    # Espressif IoT Development Framework (ESP-IDF) 6.0.0 Project Minimal Configuration
    #
    # default:
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_ORPHAN_SECTIONS_WARNING=y
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=15
CONFIG_BT_NIMBLE_MAX_CCCDS=60
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
# Avoid logging every mouse notification; retain host warnings and errors.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_LIBC_NEWLIB=y
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=n
CONFIG_TINYUSB_DESC_CUSTOM_VID=0xd00
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x72c
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="R-SODIUM Technology"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="R-SODIUM Haptic TouchPad"
CONFIG_TINYUSB_DESC_SERIAL_STRING="0D00072C00000000"
CONFIG_TINYUSB_HID_COUNT=3

# Shared mouse implementation; BLE always uses mouse HID.
CONFIG_PTP_SIMULATED_MOUSE_MODE=y
